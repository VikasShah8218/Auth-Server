# Copy to .env for local development. Never commit the real file.

# ---------------- Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# JSON list of exact origins. "*" is refused at startup. The console is same-origin and needs none.
CORS_ORIGINS=[]
# Proxies whose X-Forwarded-For is trusted (comma-separated), so rate limits see the real client address.
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------- PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=auth
# Optional full override instead of the DB_* values:
# DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/auth

# ---------------- Redis (rate limits and login challenges only)
REDIS_URL=redis://127.0.0.1:6379/2

# ---------------- Tests (they drop and rebuild this schema, so the name must end in _test)
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/auth_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# ---------------- Secrets
# 32 random bytes in base64url. Generate one with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Back it up separately from the database: replacing it makes stored keys and TOTP secrets unreadable.
MASTER_KEY=

# ---------------- Issuer
# The address browsers use. In development that's the client on port 5181.
ISSUER=http://localhost:5181

# ---------------- Background jobs (cleanup, outbox pruning, key rotation, downstream report)
RUN_JOBS=true
JOB_INTERVAL_SECONDS=60
