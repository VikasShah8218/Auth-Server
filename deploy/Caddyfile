# One origin for the console and the API, like the Vite proxy in development: no CORS, cookies just work.
# DOMAIN=auth.example.com  -> automatic Let's Encrypt certificate (ports 80 and 443 must reach this host)
# DOMAIN=localhost or an IP -> Caddy's own internal certificate (browsers will warn until it is trusted)

{$DOMAIN:localhost} {
	encode zstd gzip

	@api path /v1/* /oauth/* /bff/* /.well-known/* /health/*
	handle @api {
		reverse_proxy api:8000 {
			# Server-Sent Events (/v1/events/*) must reach the client immediately.
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# Client-side routes such as /login and /users fall back to the SPA.
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	log {
		output stdout
		format console
	}
}
