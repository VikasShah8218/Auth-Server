# Copy to .env (next to docker-compose.yml) and fill in. Never commit the real file.

# ---------------- Address
# The public host name. A real domain gets a Let's Encrypt certificate automatically.
DOMAIN=localhost
# Must be https and exactly what browsers use. Tokens, cookies and passkeys are tied to it:
# changing it later invalidates tokens and makes existing passkeys stop working.
ISSUER=https://localhost

# ---------------- Secrets (generate both, never reuse the examples)
# 32 random bytes, base64url:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#   or: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# BACK IT UP SEPARATELY. Without it, signing keys and TOTP secrets in a database backup can't be read.
MASTER_KEY=
# Database password (letters and digits only keeps URLs simple):
#   openssl rand -hex 24
DB_PASSWORD=

# ---------------- Tuning
# uvicorn worker processes. About 70–120 MB each.
WORKERS=2
LOG_LEVEL=INFO
# JSON list of exact origins allowed to call the API from another site. The console needs none.
CORS_ORIGINS=[]

# ---------------- Host ports (change if 80/443 are taken)
HTTP_PORT=80
HTTPS_PORT=443
